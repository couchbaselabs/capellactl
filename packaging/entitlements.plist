<?xml version="1.0" encoding="UTF-8"?>
<!-- CAP-045: hardened-runtime entitlements of the signed macOS executable (capellactl.spec). The one-file build
     unpacks its Python libraries to a temporary folder at start; they are signed with the same identity, but
     library validation would still refuse them from there. -->
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
    <key>com.apple.security.cs.disable-library-validation</key>
    <true/>
</dict>
</plist>
